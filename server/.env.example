# Copy to .env for local runs. Never commit .env.
#
# Without DATABASE_URL the server uses an in-memory Postgres (PGlite): fine for
# trying it locally, but everything is gone on restart.

# Neon connection string (production). Requires TLS.
DATABASE_URL=

# Random, 24+ characters. Salts the IP hash used for rate limits; the IP itself
# is never stored. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IP_SALT=

# The site's address(es), comma-separated, so the browser may call this API.
ALLOWED_ORIGINS=https://gal-omer-offroad.onrender.com

# Optional, 24+ characters: lets you delete a message with
#   curl -X DELETE -H "Authorization: Bearer <token>" https://<api>/api/messages/<id>
ADMIN_TOKEN=

# Optional, comma-separated words that block a message or name outright.
BLOCKED_WORDS=
